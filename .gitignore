# Ignore everything by default, and then whitelist as needed
*
!.gitignore

# Project & environment configuration
!flake.nix
!flake.lock
!.python-version
!pyproject.toml
!uv.lock

# Examples and documentation
!tutorial.ipynb
!README.md

# Library implementation
!src/
!src/qif_micro/
!src/qif_micro/*.py
!src/qif_micro/mechanism/
!src/qif_micro/mechanism/*.py
!src/qif_micro/model/
!src/qif_micro/model/*.py
!src/qif_micro/qif/
!src/qif_micro/qif/*.py
!src/qif_micro/qif/datatypes/
!src/qif_micro/qif/datatypes/*.py
!src/qif_micro/qif/measure/
!src/qif_micro/qif/measure/*.py

# Unit and integration tests
!tests/
!tests/**/
!tests/**/*.py

# Experiments
!experiments/
!experiments/*.ipynb
!experiments/README.md
!experiments/benchmark/
!experiments/benchmark/**/
!experiments/benchmark/**/*.py
!experiments/benchmark/**/*.sh
!experiments/benchmark/**/*.yaml
